PORT=5000
NODE_ENV=development
GEMINI_API_KEY=your-gemini-api-key
COGNITO_USER_POOL_ID=ap-south-1_EXAMPLE
COGNITO_USER_POOL_CLIENT_ID=your-cognito-user-pool-client-id
AWS_REGION=your-aws-region
DYNAMODB_INTERVIEWS_TABLE=InterviewAce-Interviews
FRONTEND_URLS=http://localhost:5173,https://main.example.amplifyapp.com,https://app.example.com

# Render only: store these as secret environment variables.
# Local development can use the normal AWS CLI credential chain instead.
